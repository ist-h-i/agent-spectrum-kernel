#!/bin/zsh
set -euo pipefail

SCRIPT_PATH="${0:A}"
SCRIPT_DIR="${SCRIPT_PATH:h}"
REPO_ROOT="${SCRIPT_DIR:h}"
GENERATE_VSIX_COMMAND="$SCRIPT_DIR/generate-vsix.command"
OUT_DIR="$REPO_ROOT/dist"
SMOKE_ROOT="${SMOKE_ROOT:-$OUT_DIR/vsix-smoke}"
CODE_COMMAND="${CODE_COMMAND:-code}"
GENERATE_VSIX="${GENERATE_VSIX:-1}"

log() {
  printf '\n==> %s\n' "$*"
}

fail() {
  printf '\nERROR: %s\n' "$*" >&2
  exit 1
}

write_file() {
  local target_path="$1"
  local content="$2"

  mkdir -p "${target_path:h}"
  printf '%s\n' "$content" > "$target_path"
}

for command_name in git node "$CODE_COMMAND"; do
  command -v "$command_name" >/dev/null 2>&1 || fail "$command_name is required."
done

[[ -f "$REPO_ROOT/package.json" ]] || fail "Repository root was not detected from $SCRIPT_PATH"
[[ -x "$GENERATE_VSIX_COMMAND" ]] || fail "VSIX generator is not executable: $GENERATE_VSIX_COMMAND"

cd "$REPO_ROOT"

VERSION="$(node -p "require('./packages/vscode-extension/package.json').version")"
if [[ -n "${VSIX_PATH:-}" ]]; then
  VSIX_PATH="${VSIX_PATH:A}"
  OUTPUT_NAME="${OUTPUT_NAME:-${VSIX_PATH:t}}"
else
  OUTPUT_NAME="${OUTPUT_NAME:-reviewops-guard-${VERSION}-rc.vsix}"
  VSIX_PATH="$OUT_DIR/$OUTPUT_NAME"
fi
GENERATED_VSIX_PATH="$OUT_DIR/$OUTPUT_NAME"
SMOKE_ROOT="${SMOKE_ROOT:A}"
WORKSPACE_DIR="$SMOKE_ROOT/workspace"
USER_DATA_DIR="$SMOKE_ROOT/user-data"
EXTENSIONS_DIR="$SMOKE_ROOT/extensions"

case "$SMOKE_ROOT" in
  "" | "/" | "." | ".." | "dist" | "$REPO_ROOT" | "$OUT_DIR")
    fail "Refusing unsafe SMOKE_ROOT: $SMOKE_ROOT"
    ;;
esac

if [[ "$GENERATE_VSIX" != "0" ]]; then
  log "Generating ReviewOps Guard VSIX"
  OUTPUT_NAME="$OUTPUT_NAME" "$GENERATE_VSIX_COMMAND"
  if [[ "$GENERATED_VSIX_PATH" != "$VSIX_PATH" ]]; then
    mkdir -p "${VSIX_PATH:h}"
    cp "$GENERATED_VSIX_PATH" "$VSIX_PATH"
  fi
else
  log "Using existing VSIX because GENERATE_VSIX=0"
fi

[[ -f "$VSIX_PATH" ]] || fail "VSIX was not found: $VSIX_PATH"

log "Preparing isolated VS Code smoke workspace"
rm -rf "$SMOKE_ROOT"
mkdir -p "$WORKSPACE_DIR/src" "$USER_DATA_DIR" "$EXTENSIONS_DIR"

write_file "$WORKSPACE_DIR/package.json" '{
  "name": "reviewops-vsix-smoke-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node src/example.js"
  }
}'
write_file "$WORKSPACE_DIR/src/example.js" 'export function reviewMessage(name) {
  return `hello ${name}`;
}

console.log(reviewMessage("ReviewOps"));
'
write_file "$WORKSPACE_DIR/README.md" '# ReviewOps VSIX smoke workspace

This workspace is generated by scripts/smoke-vsix.command.
'

(
  cd "$WORKSPACE_DIR"
  git init -q
  git config user.email "reviewops-smoke@example.invalid"
  git config user.name "ReviewOps Smoke"
  git add package.json README.md src/example.js
  git commit -q -m "Initial ReviewOps smoke workspace"
  printf '\nexport const smokeDiff = true;\n' >> src/example.js
)

log "Installing VSIX into an isolated VS Code profile"
"$CODE_COMMAND" \
  --user-data-dir "$USER_DATA_DIR" \
  --extensions-dir "$EXTENSIONS_DIR" \
  --install-extension "$VSIX_PATH" \
  --force

log "Launching VS Code for manual P0 smoke"
"$CODE_COMMAND" \
  --new-window \
  --user-data-dir "$USER_DATA_DIR" \
  --extensions-dir "$EXTENSIONS_DIR" \
  "$WORKSPACE_DIR"

printf '\nManual ReviewOps Guard P0 smoke steps:\n'
printf '1. Run "ReviewOps: Initialize Project".\n'
printf '2. Run "ReviewOps: Update Project Context" and enter smoke-safe project context.\n'
printf '3. Run "ReviewOps: Status" and confirm the workspace is initialized.\n'
printf '4. Run "ReviewOps: Next Action" and confirm it points at a P0 flow.\n'
printf '5. Run "ReviewOps: Prepare Local Diff Review" and confirm a prompt artifact opens.\n'
printf '6. Open the ReviewOps sidebar views: Review Work, Knowledge, Skill Evidence, Reports.\n'
printf '7. Run "ReviewOps: Show P0 Readiness", select the six verified smoke steps, and confirm p0-readiness artifacts are written.\n'
printf '\nSmoke workspace: %s\n' "$WORKSPACE_DIR"
printf 'VS Code user data: %s\n' "$USER_DATA_DIR"
printf 'VS Code extensions: %s\n' "$EXTENSIONS_DIR"
