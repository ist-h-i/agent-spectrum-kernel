{
  "name": "reviewops-guard",
  "displayName": "%reviewops.displayName%",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "%reviewops.description%",
  "publisher": "reviewops",
  "icon": "resources/reviewops_guard_icon_128.png",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "activationEvents": [
    "onCommand:reviewops.initializeProject",
    "onCommand:reviewops.updateProjectContext",
    "onCommand:reviewops.openPreview",
    "onCommand:reviewops.openArtifacts",
    "onCommand:reviewops.commandCenter",
    "onCommand:reviewops.nextAction",
    "onCommand:reviewops.resumeCurrentCycle",
    "onCommand:reviewops.prepareGitHubPullRequestReview",
    "onCommand:reviewops.previewGitHubReplyComment",
    "onCommand:reviewops.prepareGitHubCommentTriage",
    "onCommand:reviewops.prepareLocalDiffReview",
