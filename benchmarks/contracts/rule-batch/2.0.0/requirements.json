{
  "definition_id": "ask.rule-batch-judgment@2.0.0",
  "requirements": [
    {
      "id": "r1",
      "original_requirement": "`RuleService.applyBatch(request)` is a public API and the relevant error type is exported from `src/index.mjs`.",
      "criterion": "Public API and exported errors",
      "inputs": "import src/index.mjs; invoke applyBatch; invalid/collision/version requests",
      "expected_result": "exported functions; typed errors",
      "error": "RuleValidationError, IdempotencyConflictError, VersionConflictError",
      "state_invariant": "invalid requests do not consume IDs",
      "cases": [
        "api-exports"
      ],
      "limits": "Finite ordinary JS records and one service/store lifecycle; not exhaustive, no proxies/accessor side effects, persistence/restart or concurrent process claims.",
      "historical_cases": [
        "public-call-and-exported-errors"
      ]
    },
