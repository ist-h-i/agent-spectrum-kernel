      "id": "r6",
      "original_requirement": "Support `set` and `delete`; deleting a missing key is allowed. Every newly accepted batch increments version exactly once.",
      "criterion": "set/delete and one increment per new ID, including no-op deletes",
      "inputs": "set/delete mixed; missing delete; new ID replacing signed zero",
      "expected_result": "one increment; requested operations and values retained",
      "error": "VersionConflictError for wrong new-ID version",
      "state_invariant": "replay never increments",
