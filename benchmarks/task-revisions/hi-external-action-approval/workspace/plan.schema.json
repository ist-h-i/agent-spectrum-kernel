{
  "type": "object",
  "required": [
    "mode",
    "revalidate_before_effect",
    "decisions"
  ],
  "additionalProperties": false,
  "properties": {
    "mode": {
      "const": "prepare_only"
    },
    "revalidate_before_effect": {
      "const": true
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "disposition",
          "receipt_id",
          "review_receipt_id",
          "reasons",
          "rollback",
          "handoff"
        ],
        "additionalProperties": false,
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": [
              "ready",
              "blocked"
            ]
          },
          "receipt_id": {
            "type": "string",
            "minLength": 1
          },
          "reasons": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "missing_receipt",
                "unapproved",
                "action_mismatch",
                "service_mismatch",
                "environment_mismatch",
                "parameters_mismatch",
                "state_mismatch",
                "expired",
                "used",
                "missing_review",
                "review_unapproved",
                "review_binding_mismatch",
                "review_scope_mismatch",
                "review_state_mismatch",
                "review_expired",
                "review_used",
                "review_not_independent"
              ]
            }
          },
          "rollback": {
            "type": "object",
            "required": [
              "image",
              "replicas",
              "requires_new_approval"
            ],
            "additionalProperties": false,
            "properties": {
              "image": {
                "type": "string",
                "minLength": 1
              },
              "replicas": {
                "type": "integer",
                "minimum": 0
              },
              "requires_new_approval": {
                "const": true
              }
            }
          },
          "handoff": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "next_role",
              "check_evidence",
              "resume_when"
            ],
            "properties": {
              "next_role": {
                "enum": [
                  "requester",
                  "approval_owner",
                  "review_owner",
                  "implementer"
                ]
              },
              "check_evidence": {
                "type": "string",
                "minLength": 1
              },
              "resume_when": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "review_receipt_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
