{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Profile migration shift report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dispatch",
    "pages",
    "containment"
  ],
  "properties": {
    "dispatch": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "work",
          "checkpoint",
          "gates",
          "next",
          "sources",
          "instruction"
        ],
        "properties": {
          "work": {
            "type": "string",
            "minLength": 1
          },
          "checkpoint": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "link",
              "batch",
              "upper"
            ],
            "properties": {
              "link": {
                "type": "string",
                "minLength": 1
              },
              "batch": {
                "type": "integer",
                "minimum": 0
              },
              "upper": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "gates": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "comparison",
              "clients",
              "release",
              "delivery"
            ],
            "properties": {
              "comparison": {
                "enum": [
                  "cleared",
                  "open"
                ]
              },
              "clients": {
                "enum": [
                  "cleared",
                  "open"
                ]
              },
              "release": {
                "enum": [
                  "cleared",
                  "open"
                ]
              },
              "delivery": {
                "enum": [
                  "never_sent",
                  "unsettled",
                  "applied",
                  "not_applied"
                ]
              }
            },
            "description": "Open means that the current record does not establish clearance for the work order."
          },
          "next": {
            "$ref": "#/$defs/action"
          },
          "sources": {
            "$ref": "#/$defs/sources"
          },
          "instruction": {
            "$ref": "#/$defs/instruction"
          }
        }
      },
      "description": "One instruction per assigned work order."
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "page",
          "next",
          "sources",
          "instruction"
        ],
        "properties": {
          "page": {
            "type": "string",
            "minLength": 1
          },
          "next": {
            "$ref": "#/$defs/action"
          },
          "sources": {
            "$ref": "#/$defs/sources"
          },
          "instruction": {
            "$ref": "#/$defs/instruction"
          }
        }
      },
      "description": "One instruction for the affected work order in each independent page."
    },
    "containment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actions",
        "retain",
        "instruction"
      ],
      "properties": {
        "actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "retain": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "instruction": {
          "$ref": "#/$defs/instruction"
        }
      },
      "description": "Specify the incident actions and record stores from the catalog that the on-call team needs."
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "owner",
        "delivery_key"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1,
          "description": "Dispatch command ID from the operations catalog."
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "delivery_key": {
          "type": [
            "string",
            "null"
          ],
          "description": "Use the recorded delivery key for key-bound commands and null otherwise."
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Cite individual IDs from the supplied operational records for this decision."
    },
    "instruction": {
      "type": "string",
      "minLength": 1,
      "description": "Explain the choice, its scope and what the operator should do next."
    }
  }
}
