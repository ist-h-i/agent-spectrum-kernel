{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Adaptive ASK portfolio execution attempt result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "run_instance_id", "case_id", "attempt", "adapter", "condition", "runtime_identity_digest", "effective_command_digest", "request_sha256", "command_evidence", "terminal_workspace_authority_availability", "terminal_workspace_authority_support", "terminal_workspace_authority_path", "terminal_workspace_authority_sha256", "terminal_workspace_authority_bytes", "terminal_workspace_authority_digest", "terminal_workspace_tree_digest", "terminal_workspace_authority_file_identity", "status", "exit_code", "duration_ms", "failure_kind", "recovery_reason", "final_output", "stdout", "stderr", "event_counts"],
  "properties": {
    "schema_version": { "enum": ["1.2.0", "1.3.0"] },
    "kind": { "const": "result" },
    "run_instance_id": { "type": "string", "format": "uuid" },
    "case_id": { "type": "string", "pattern": "^case-[a-f0-9]{16}-[a-f0-9]{16}$" },
    "attempt": { "type": "string", "pattern": "^[0-9]{4}$" },
    "adapter": { "enum": ["codex", "claude"] },
    "condition": { "enum": ["plain", "kernel_only", "adaptive_ask", "full_ask"] },
    "runtime_identity_digest": { "$ref": "#/$defs/digest" },
    "effective_command_digest": { "$ref": "#/$defs/digest" },
    "request_sha256": { "$ref": "#/$defs/digest" },
    "command_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "bytes", "capture_status", "evidence_count", "file_identity"],
      "properties": {
        "path": { "const": "command-evidence.json" },
        "digest": { "$ref": "#/$defs/digest" },
        "bytes": { "type": "integer", "minimum": 1 },
        "capture_status": { "enum": ["executed", "unavailable"] },
        "evidence_count": { "type": "integer", "minimum": 0 },
        "file_identity": {
          "type": "object", "additionalProperties": false, "required": ["device", "inode", "size", "mtime_ms", "ctime_ms", "raw_digest", "canonical_path"],
          "properties": {
            "device": { "type": "string", "pattern": "^[0-9]+$" },
            "inode": { "type": "string", "pattern": "^[0-9]+$" },
            "size": { "type": "integer", "minimum": 1 },
            "mtime_ms": { "type": "number", "minimum": 0 },
            "ctime_ms": { "type": "number", "minimum": 0 },
            "raw_digest": { "$ref": "#/$defs/digest" },
            "canonical_path": {
              "type": "object", "additionalProperties": false, "required": ["classification", "digest"],
              "properties": { "classification": { "const": "attempt_relative" }, "digest": { "$ref": "#/$defs/digest" } }
            }
          }
        }
      }
    },
    "terminal_workspace_authority_availability": { "enum": ["captured", "unavailable"] },
    "terminal_workspace_authority_support": { "const": "supported" },
    "terminal_workspace_authority_path": { "type": ["string", "null"], "pattern": "^terminal-workspace-authority\\.json$" },
    "terminal_workspace_authority_sha256": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
    "terminal_workspace_authority_bytes": { "type": ["integer", "null"], "minimum": 1 },
    "terminal_workspace_authority_digest": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
    "terminal_workspace_tree_digest": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
    "terminal_workspace_authority_file_identity": { "oneOf": [{ "$ref": "#/$defs/fileIdentity" }, { "type": "null" }] },
    "status": { "enum": ["completed", "failed", "unavailable", "interrupted", "invalid"] },
    "exit_code": { "type": ["integer", "null"] },
    "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
    "failure_kind": { "type": ["string", "null"], "minLength": 1, "maxLength": 160, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029]+$" },
    "recovery_reason": { "$ref": "#/$defs/recoveryReason" },
    "final_output": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "const": "final.json" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 }
      }
    },
    "stdout": { "$ref": "#/$defs/stream" },
    "stderr": { "$ref": "#/$defs/stream" },
    "successor_usage": { "$ref": "#/$defs/successorUsage" },
    "event_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["json_lines"],
      "properties": { "json_lines": { "type": "integer", "minimum": 0 } }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schema_version": { "const": "1.3.0" } }, "required": ["schema_version"] },
      "then": { "required": ["successor_usage"], "properties": { "adapter": { "const": "codex" }, "condition": { "const": "full_ask" } } },
      "else": { "not": { "required": ["successor_usage"] } }
    },
    {
      "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
      "then": {
        "properties": {
          "exit_code": { "const": 0 },
          "failure_kind": { "type": "null" },
          "recovery_reason": { "type": "null" },
          "final_output": { "$ref": "#/$defs/finalOutput" }
        }
      },
      "else": {
        "properties": {
          "failure_kind": { "type": "string", "minLength": 1 },
          "final_output": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "failure_kind": { "const": "stale_claim_recovered" } }, "required": ["failure_kind"] },
      "then": { "properties": { "recovery_reason": { "$ref": "#/$defs/recoveryReasonEvidence" } } },
      "else": { "properties": { "recovery_reason": { "type": "null" } } }
    },
    {
      "if": { "properties": { "terminal_workspace_authority_availability": { "const": "captured" } }, "required": ["terminal_workspace_authority_availability"] },
      "then": {
        "properties": {
          "terminal_workspace_authority_path": { "const": "terminal-workspace-authority.json" },
          "terminal_workspace_authority_sha256": { "$ref": "#/$defs/digest" },
          "terminal_workspace_authority_bytes": { "type": "integer", "minimum": 1 },
          "terminal_workspace_authority_digest": { "$ref": "#/$defs/digest" },
          "terminal_workspace_tree_digest": { "$ref": "#/$defs/digest" },
          "terminal_workspace_authority_file_identity": { "$ref": "#/$defs/fileIdentity" }
        }
      },
      "else": {
        "properties": {
          "terminal_workspace_authority_path": { "type": "null" },
          "terminal_workspace_authority_sha256": { "type": "null" },
          "terminal_workspace_authority_bytes": { "type": "null" },
          "terminal_workspace_authority_digest": { "type": "null" },
          "terminal_workspace_tree_digest": { "type": "null" },
          "terminal_workspace_authority_file_identity": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
      "then": { "properties": { "terminal_workspace_authority_availability": { "const": "captured" } } }
    }
  ],
  "$defs": {
    "successorUsage": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "parser_revision", "source_stdout", "metrics"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "parser_revision": { "const": "codex-exec-jsonl-usage-v1" },
        "source_stdout": { "$ref": "#/$defs/stream" },
        "metrics": {
          "type": "object", "additionalProperties": false,
          "required": ["input_tokens", "output_tokens", "cached_tokens", "total_tokens"],
          "properties": {
            "input_tokens": { "$ref": "#/$defs/usageMetric" },
            "output_tokens": { "$ref": "#/$defs/usageMetric" },
            "cached_tokens": { "$ref": "#/$defs/usageMetric" },
            "total_tokens": { "$ref": "#/$defs/usageMetric" }
          }
        }
      }
    },
    "usageMetric": {
      "type": "object", "additionalProperties": false, "required": ["status", "value", "reason"],
      "properties": {
        "status": { "enum": ["known", "unknown"] },
        "value": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
        "reason": { "enum": [null, "process_incomplete", "stream_invalid", "turn_incomplete", "ambiguous_turn", "invalid_usage", "usage_field_unavailable"] }
      },
      "allOf": [{
        "if": { "properties": { "status": { "const": "known" } }, "required": ["status"] },
        "then": { "properties": { "value": { "type": "integer" }, "reason": { "type": "null" } } },
        "else": { "properties": { "value": { "type": "null" }, "reason": { "type": "string" } } }
      }]
    },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "fileIdentity": {
      "type": "object", "additionalProperties": false, "required": ["device", "inode", "size", "mtime_ms", "ctime_ms", "raw_digest", "canonical_path"],
      "properties": {
        "device": { "type": "string", "pattern": "^[0-9]+$" },
        "inode": { "type": "string", "pattern": "^[0-9]+$" },
        "size": { "type": "integer", "minimum": 1 },
        "mtime_ms": { "type": "number", "minimum": 0 },
        "ctime_ms": { "type": "number", "minimum": 0 },
        "raw_digest": { "$ref": "#/$defs/digest" },
        "canonical_path": {
          "type": "object", "additionalProperties": false, "required": ["classification", "digest"],
          "properties": { "classification": { "const": "attempt_relative" }, "digest": { "$ref": "#/$defs/digest" } }
        }
      }
    },
    "recoveryReason": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["value", "digest", "bytes"],
      "properties": {
        "value": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029]+$" },
        "digest": { "$ref": "#/$defs/digest" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "recoveryReasonEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "digest", "bytes"],
      "properties": {
        "value": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029]+$" },
        "digest": { "$ref": "#/$defs/digest" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "finalOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "const": "final.json" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 }
      }
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "sha256"],
      "properties": {
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
