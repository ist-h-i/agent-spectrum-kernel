            "exclusion_removes_entire_group",
            "incomplete_component_evidence",
            "exact_native_component_vector_comparison",
            "human_effort_evidence_incomplete",
            "no_applicable_human_effort_samples"
          ]
        }
      }
    },
    "v2Boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
