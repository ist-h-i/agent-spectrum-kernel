{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ask.primary-public-capability-selection@2.0.0",
  "title": "Source-configured Full routing selection, not runtime admission",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "adapter", "profile", "projection_fingerprint", "selection_basis", "selected_skills", "skill_assets", "runtime_enabled_selection", "execution_authority", "scoring_authority", "formal_aggregate_eligible"],
  "properties": {
    "kind": { "const": "ask_primary_public_capability_selection_v2" },
    "adapter": { "const": "codex" },
    "profile": { "const": "full" },
    "projection_fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "selection_basis": { "const": "source_owned_full_projection" },
    "selected_skills": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" } },
    "skill_assets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["skill", "path", "digest", "bytes", "mode"],
      "properties": {
        "skill": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "path": { "type": "string", "pattern": "^\\.agents/skills/[a-z0-9][a-z0-9-]*/SKILL\\.md$" },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 },
        "mode": { "const": "100644" }
      }
    } },
    "runtime_enabled_selection": { "const": "unobserved" },
    "execution_authority": { "const": false },
    "scoring_authority": { "const": false },
    "formal_aggregate_eligible": { "const": false }
  }
}
