{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Adaptive ASK private evaluation execution record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_path",
    "program",
    "evaluator_bundle_id",
    "evaluator_bundle_digest",
    "evaluator_revision",
    "evaluator_source_identity",
    "normalized_result_id",
    "normalized_result_digest",
    "run_instance_id",
    "case_id",
    "attempt",
    "hidden_evaluator_asset_role",
    "hidden_evaluator_path",
    "hidden_evaluator_sha256",
    "hidden_evaluator_bytes",
    "hidden_evaluator_entry_point",
    "hidden_evaluator_inode",
    "evaluator_runner_path",
    "evaluator_runner_sha256",
    "evaluator_runner_bytes",
    "evaluator_runner_inode",
    "evaluator_runner_source_identity",
    "dependency_graph_digest",
    "sealed_repository_root_relative_path",
    "sealed_repository_descriptor_relative_path",
    "sealed_repository_descriptor_sha256",
    "sealed_repository_descriptor_bytes",
    "sealed_repository_source_graph_digest",
    "sealed_repository_fixture_authority_digest",
    "sealed_repository_portable_digest",
    "sealed_repository_runtime_digest",
    "sealed_repository_root_identity_before",
    "sealed_repository_root_identity_after_first",
    "sealed_repository_root_identity_after_second",
    "frozen_workspace_path",
    "candidate_workspace_path",
    "evaluation_input_evidence_root_path",
    "frozen_workspace_original_identity",
    "candidate_workspace_original_identity",
    "evaluator_runner_sealed_execution_path",
    "evaluator_runner_sealed_sha256",
    "evaluator_runner_sealed_bytes",
    "evaluator_runner_sealed_dev",
    "evaluator_runner_sealed_inode",
    "evaluator_runner_sealed_nlink",
    "evaluator_runner_sealed_mtime_ms",
    "evaluator_runner_sealed_ctime_ms",
    "evaluator_runner_sealed_execution_identity_before",
    "evaluator_runner_sealed_execution_identity_after",
    "hidden_evaluator_sealed_execution_path",
    "hidden_evaluator_sealed_sha256",
    "hidden_evaluator_sealed_bytes",
    "hidden_evaluator_sealed_dev",
    "hidden_evaluator_sealed_inode",
    "hidden_evaluator_sealed_nlink",
    "hidden_evaluator_sealed_mtime_ms",
    "hidden_evaluator_sealed_ctime_ms",
    "hidden_evaluator_sealed_execution_identity_before",
    "hidden_evaluator_sealed_execution_identity_after",
    "frozen_workspace_sealed_execution_path",
    "candidate_workspace_sealed_execution_path",
    "evaluation_input_evidence_sealed_execution_path",
    "frozen_workspace_sealed_inventory_digest",
    "candidate_workspace_sealed_inventory_digest",
    "evaluation_input_evidence_sealed_inventory_digest",
    "frozen_workspace_sealed_runtime_digest",
    "candidate_workspace_sealed_runtime_digest",
    "evaluation_input_evidence_sealed_runtime_digest",
    "frozen_workspace_sealed_runtime_identity_before",
    "frozen_workspace_sealed_runtime_identity_after",
    "candidate_workspace_sealed_runtime_identity_before",
    "candidate_workspace_sealed_runtime_identity_after",
    "evaluation_input_evidence_sealed_runtime_identity_before",
    "evaluation_input_evidence_sealed_runtime_identity_after",
    "evaluator_execution_status",
    "first_run_fragment_sha256",
    "first_run_fragment_bytes",
    "second_run_fragment_sha256",
    "second_run_fragment_bytes",
    "deterministic_rerun",
    "frozen_workspace_inventory_digest",
    "candidate_workspace_inventory_digest",
    "repository_diff_artifact_digest",
    "repository_diff_artifact_bytes",
    "private_fragment_path",
    "private_fragment_sha256",
    "private_fragment_bytes",
    "private_fragment_inode",
    "fragment_schema_digest",
    "adapter_source_digest",
    "adapter_result_envelope_digest",
    "evidence_artifacts",
    "evaluation_record_digest"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "schema_path": { "const": "benchmarks/schemas/private-evaluation-record.schema.json" },
    "program": { "const": "adaptive_ask_private_evaluation_record" },
    "evaluator_bundle_id": { "$ref": "#/$defs/bundleId" },
    "evaluator_bundle_digest": { "$ref": "#/$defs/digest" },
    "evaluator_revision": { "$ref": "#/$defs/revision" },
    "evaluator_source_identity": { "type": "object", "minProperties": 1 },
    "normalized_result_id": { "type": "string", "pattern": "^normalized-[a-f0-9]{32}$" },
    "normalized_result_digest": { "$ref": "#/$defs/digest" },
    "run_instance_id": { "type": "string", "format": "uuid" },
    "case_id": { "type": "string", "pattern": "^case-[a-f0-9]{16}-[a-f0-9]{16}$" },
    "attempt": { "type": "string", "pattern": "^[0-9]{4}$" },
    "hidden_evaluator_asset_role": { "const": "hidden_tests" },
    "hidden_evaluator_path": { "$ref": "#/$defs/path" },
    "hidden_evaluator_sha256": { "$ref": "#/$defs/digest" },
    "hidden_evaluator_bytes": { "type": "integer", "minimum": 1 },
    "hidden_evaluator_entry_point": { "const": "evaluateCandidateSafe" },
    "hidden_evaluator_inode": { "type": "integer", "minimum": 1 },
    "evaluator_runner_path": { "$ref": "#/$defs/path" },
    "evaluator_runner_sha256": { "$ref": "#/$defs/digest" },
    "evaluator_runner_bytes": { "type": "integer", "minimum": 1 },
    "evaluator_runner_inode": { "type": "integer", "minimum": 1 },
    "evaluator_runner_source_identity": { "$ref": "#/$defs/runnerSourceIdentity" },
    "dependency_graph_digest": { "$ref": "#/$defs/digest" },
    "sealed_repository_root_relative_path": { "$ref": "#/$defs/path" },
    "sealed_repository_descriptor_relative_path": { "$ref": "#/$defs/path" },
    "sealed_repository_descriptor_sha256": { "$ref": "#/$defs/digest" },
    "sealed_repository_descriptor_bytes": { "type": "integer", "minimum": 1 },
    "sealed_repository_source_graph_digest": { "$ref": "#/$defs/digest" },
    "sealed_repository_fixture_authority_digest": { "$ref": "#/$defs/digest" },
    "sealed_repository_portable_digest": { "$ref": "#/$defs/digest" },
    "sealed_repository_runtime_digest": { "$ref": "#/$defs/digest" },
    "sealed_repository_root_identity_before": { "$ref": "#/$defs/rootIdentity" },
    "sealed_repository_root_identity_after_first": { "$ref": "#/$defs/rootIdentity" },
    "sealed_repository_root_identity_after_second": { "$ref": "#/$defs/rootIdentity" },
    "frozen_workspace_path": { "$ref": "#/$defs/path" },
    "candidate_workspace_path": { "$ref": "#/$defs/path" },
    "evaluation_input_evidence_root_path": { "$ref": "#/$defs/path" },
    "frozen_workspace_original_identity": { "$ref": "#/$defs/workspaceIdentity" },
    "candidate_workspace_original_identity": { "$ref": "#/$defs/workspaceIdentity" },
    "evaluator_runner_sealed_execution_path": { "$ref": "#/$defs/path" },
    "evaluator_runner_sealed_sha256": { "$ref": "#/$defs/digest" },
    "evaluator_runner_sealed_bytes": { "type": "integer", "minimum": 1 },
    "evaluator_runner_sealed_dev": { "type": "integer", "minimum": 0 },
    "evaluator_runner_sealed_inode": { "type": "integer", "minimum": 1 },
    "evaluator_runner_sealed_nlink": { "type": "integer", "minimum": 1 },
    "evaluator_runner_sealed_mtime_ms": { "type": "number" },
    "evaluator_runner_sealed_ctime_ms": { "type": "number" },
    "evaluator_runner_sealed_execution_identity_before": { "$ref": "#/$defs/filesystemIdentity" },
    "evaluator_runner_sealed_execution_identity_after": { "$ref": "#/$defs/filesystemIdentity" },
    "hidden_evaluator_sealed_execution_path": { "$ref": "#/$defs/path" },
    "hidden_evaluator_sealed_sha256": { "$ref": "#/$defs/digest" },
    "hidden_evaluator_sealed_bytes": { "type": "integer", "minimum": 1 },
    "hidden_evaluator_sealed_dev": { "type": "integer", "minimum": 0 },
    "hidden_evaluator_sealed_inode": { "type": "integer", "minimum": 1 },
    "hidden_evaluator_sealed_nlink": { "type": "integer", "minimum": 1 },
    "hidden_evaluator_sealed_mtime_ms": { "type": "number" },
    "hidden_evaluator_sealed_ctime_ms": { "type": "number" },
    "hidden_evaluator_sealed_execution_identity_before": { "$ref": "#/$defs/filesystemIdentity" },
    "hidden_evaluator_sealed_execution_identity_after": { "$ref": "#/$defs/filesystemIdentity" },
    "frozen_workspace_sealed_execution_path": { "$ref": "#/$defs/path" },
    "candidate_workspace_sealed_execution_path": { "$ref": "#/$defs/path" },
    "evaluation_input_evidence_sealed_execution_path": { "$ref": "#/$defs/path" },
    "frozen_workspace_sealed_inventory_digest": { "$ref": "#/$defs/digest" },
    "candidate_workspace_sealed_inventory_digest": { "$ref": "#/$defs/digest" },
    "evaluation_input_evidence_sealed_inventory_digest": { "$ref": "#/$defs/digest" },
    "frozen_workspace_sealed_runtime_digest": { "$ref": "#/$defs/digest" },
    "candidate_workspace_sealed_runtime_digest": { "$ref": "#/$defs/digest" },
    "evaluation_input_evidence_sealed_runtime_digest": { "$ref": "#/$defs/digest" },
    "frozen_workspace_sealed_runtime_identity_before": { "$ref": "#/$defs/workspaceIdentity" },
    "frozen_workspace_sealed_runtime_identity_after": { "$ref": "#/$defs/workspaceIdentity" },
    "candidate_workspace_sealed_runtime_identity_before": { "$ref": "#/$defs/workspaceIdentity" },
    "candidate_workspace_sealed_runtime_identity_after": { "$ref": "#/$defs/workspaceIdentity" },
    "evaluation_input_evidence_sealed_runtime_identity_before": { "$ref": "#/$defs/workspaceIdentity" },
    "evaluation_input_evidence_sealed_runtime_identity_after": { "$ref": "#/$defs/workspaceIdentity" },
    "evaluator_execution_status": { "const": "completed" },
    "first_run_fragment_sha256": { "$ref": "#/$defs/digest" },
    "first_run_fragment_bytes": { "type": "integer", "minimum": 1 },
    "second_run_fragment_sha256": { "$ref": "#/$defs/digest" },
    "second_run_fragment_bytes": { "type": "integer", "minimum": 1 },
    "deterministic_rerun": { "const": true },
    "frozen_workspace_inventory_digest": { "$ref": "#/$defs/digest" },
    "candidate_workspace_inventory_digest": { "$ref": "#/$defs/digest" },
    "repository_diff_artifact_digest": { "$ref": "#/$defs/digest" },
    "repository_diff_artifact_bytes": { "type": "integer", "minimum": 1 },
    "private_fragment_path": { "$ref": "#/$defs/path" },
    "private_fragment_sha256": { "$ref": "#/$defs/digest" },
    "private_fragment_bytes": { "type": "integer", "minimum": 1 },
    "private_fragment_inode": { "type": "integer", "minimum": 1 },
    "fragment_schema_digest": { "$ref": "#/$defs/digest" },
    "adapter_source_digest": { "$ref": "#/$defs/digest" },
    "adapter_result_envelope_digest": { "$ref": "#/$defs/digest" },
    "evidence_artifacts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/evidenceArtifact" } },
    "evaluation_record_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "filesystemIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dev", "ino", "nlink", "mode", "size", "mtimeMs", "ctimeMs"],
      "properties": {
        "dev": { "type": "integer", "minimum": 0 },
        "ino": { "type": "integer", "minimum": 1 },
        "nlink": { "type": "integer", "minimum": 1 },
        "mode": { "type": "integer", "minimum": 0 },
        "size": { "type": "integer", "minimum": 0 },
        "mtimeMs": { "type": "number" },
        "ctimeMs": { "type": "number" }
      }
    },
    "workspaceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["portable_digest", "runtime_digest", "root"],
      "properties": {
        "portable_digest": { "$ref": "#/$defs/digest" },
        "runtime_digest": { "$ref": "#/$defs/digest" },
        "root": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dev", "ino", "nlink", "mode", "mtimeMs", "ctimeMs"],
          "properties": {
            "dev": { "type": "integer", "minimum": 0 },
            "ino": { "type": "integer", "minimum": 1 },
            "nlink": { "type": "integer", "minimum": 1 },
            "mode": { "type": "integer", "minimum": 0 },
            "mtimeMs": { "type": "number" },
            "ctimeMs": { "type": "number" }
          }
        }
      }
    },
    "rootIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dev", "ino", "nlink", "mode", "mtimeMs", "ctimeMs"],
      "properties": {
        "dev": { "type": "integer", "minimum": 0 },
        "ino": { "type": "integer", "minimum": 1 },
        "nlink": { "type": "integer", "minimum": 1 },
        "mode": { "type": "integer", "minimum": 0 },
        "mtimeMs": { "type": "number" },
        "ctimeMs": { "type": "number" }
      }
    },
    "runnerSourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "base_git_revision", "source_bytes", "source_sha256", "base_git_revision_bytes", "base_git_revision_sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "base_git_revision": { "$ref": "#/$defs/revision" },
        "source_bytes": { "type": "integer", "minimum": 1 },
        "source_sha256": { "$ref": "#/$defs/digest" },
        "base_git_revision_bytes": { "type": "integer", "minimum": 1 },
        "base_git_revision_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "bundleId": { "type": "string", "pattern": "^evaluator-[a-f0-9]{64}$" },
    "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!\\./)[a-zA-Z0-9._/-]+$" },
    "evidenceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "digest", "bytes", "inode", "run_instance_id", "case_id", "attempt", "normalized_result_id", "normalized_result_digest", "evaluator_bundle_id", "evaluator_bundle_digest"],
      "properties": {
        "kind": { "enum": ["repository_diff", "test_result"] },
        "path": { "$ref": "#/$defs/path" },
        "digest": { "$ref": "#/$defs/digest" },
        "bytes": { "type": "integer", "minimum": 1 },
        "inode": { "type": "integer", "minimum": 1 },
        "run_instance_id": { "type": "string", "format": "uuid" },
        "case_id": { "type": "string", "pattern": "^case-[a-f0-9]{16}-[a-f0-9]{16}$" },
        "attempt": { "type": "string", "pattern": "^[0-9]{4}$" },
        "normalized_result_id": { "type": "string", "pattern": "^normalized-[a-f0-9]{32}$" },
        "normalized_result_digest": { "$ref": "#/$defs/digest" },
        "evaluator_bundle_id": { "$ref": "#/$defs/bundleId" },
        "evaluator_bundle_digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
