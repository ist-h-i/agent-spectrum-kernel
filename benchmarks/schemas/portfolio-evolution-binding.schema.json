{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pre-result exact B1 execution to Evolution selection binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["roles", "execution"],
  "properties": {
    "roles": {"$ref": "../../schemas/evolution-experiment.schema.json#/$defs/roles"},
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_revision",
        "plan_id",
        "plan_digest",
        "run_instance_id",
        "adapter_track",
        "runtime_identity_digest",
        "materialization_manifest_digest",
        "selection_state_digest",
        "group",
        "fixtures",
        "catalog_digest",
        "policy_manifest_digest",
        "scoring_policy_digest",
        "classification_records",
        "lineage_records"
      ],
      "properties": {
        "source_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "plan_id": {"type": "string", "pattern": "^plan-[a-f0-9]{64}$"},
        "plan_digest": {"$ref": "portfolio-aggregate-result-v2.schema.json#/$defs/digest"},
        "run_instance_id": {"type": "string", "format": "uuid"},
        "adapter_track": {"enum": ["codex", "claude"]},
        "runtime_identity_digest": {"$ref": "portfolio-aggregate-result-v2.schema.json#/$defs/digest"},
        "materialization_manifest_digest": {"$ref": "portfolio-aggregate-result-v2.schema.json#/$defs/digest"},
        "selection_state_digest": {"$ref": "portfolio-aggregate-result-v2.schema.json#/$defs/digest"},
        "group": {
          "type": "object",
          "additionalProperties": false,
          "required": ["comparison_view", "suite", "task_class"],
          "properties": {
            "comparison_view": {"const": "adaptive_vs_kernel"},
            "suite": {"enum": ["mechanism_positive", "mechanism_negative", "practice_frequency", "high_impact"]},
            "task_class": {"$ref": "portfolio-aggregate-result-v2.schema.json#/$defs/token"}
          }
        },
        "fixtures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fixture_id", "fixture_input_digest", "expected_repetition_count"],
            "properties": {
              "fixture_id": {"$ref": "portfolio-aggregate-result-v2.schema.json#/$defs/token"},
              "fixture_input_digest": {"$ref": "portfolio-aggregate-result-v2.schema.json#/$defs/digest"},
              "expected_repetition_count": {"enum": [3, 5]}
            }
          }
        },
        "catalog_digest": {"$ref": "portfolio-aggregate-result-v2.schema.json#/$defs/digest"},
        "policy_manifest_digest": {"$ref": "portfolio-aggregate-result-v2.schema.json#/$defs/digest"},
        "scoring_policy_digest": {"$ref": "portfolio-aggregate-result-v2.schema.json#/$defs/digest"},
        "classification_records": {"type": "array", "items": {"$ref": "portfolio-aggregate-result-v2.schema.json#/$defs/classificationReference"}},
        "lineage_records": {"type": "array", "items": {"$ref": "portfolio-aggregate-result-v2.schema.json#/$defs/lineageReference"}}
      }
    }
  }
}
