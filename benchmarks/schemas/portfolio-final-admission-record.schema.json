{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Adaptive ASK portfolio final admission record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_id",
    "catalog_digest",
    "input_manifest_digest",
    "evaluator_reference_schema",
    "evaluator_bundle_id",
    "evaluator_bundle_digest",
    "evaluator_byte_count",
    "evaluator_requirement_count",
    "evidence_map_ids",
    "mutation_set_ids",
    "reviewer_record_id",
    "admission_revision",
    "admission_status",
    "admission_digest"
  ],
  "properties": {
    "fixture_id": { "$ref": "#/$defs/token" },
    "catalog_digest": { "$ref": "#/$defs/digest" },
    "input_manifest_digest": { "$ref": "#/$defs/digest" },
    "evaluator_reference_schema": { "const": "benchmarks/schemas/evaluator-reference.schema.json" },
    "evaluator_bundle_id": { "type": "string", "pattern": "^evaluator-[a-f0-9]{64}$" },
    "evaluator_bundle_digest": { "$ref": "#/$defs/digest" },
    "evaluator_source_identity": { "$ref": "#/$defs/sourceIdentity" },
    "evaluator_byte_count": { "type": "integer", "minimum": 0 },
    "evaluator_requirement_count": { "type": "integer", "minimum": 1 },
    "evidence_map_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/token" } },
    "mutation_set_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/token" } },
    "reviewer_record_id": { "$ref": "#/$defs/token" },
    "admission_revision": { "type": "integer", "minimum": 1 },
    "admission_status": { "enum": ["design_pending", "design_reviewed", "implementation_pending", "admission_pending", "admitted", "rejected"] },
    "admission_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "token": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9_-]*$" }
    ,"revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
    ,"path": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!\\./)[a-zA-Z0-9._/-]+$" }
    ,"sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_git_revision", "source_tree_digest", "generator_source_digest", "source_files", "dependency_graph"],
      "properties": {
        "base_git_revision": { "$ref": "#/$defs/revision" },
        "source_tree_digest": { "$ref": "#/$defs/digest" },
        "generator_source_digest": { "$ref": "#/$defs/digest" },
        "source_files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "bytes", "sha256"],
            "properties": {
              "path": { "$ref": "#/$defs/path" },
              "bytes": { "type": "integer", "minimum": 1 },
              "sha256": { "$ref": "#/$defs/digest" }
            }
          }
        },
        "dependency_graph": { "$ref": "#/$defs/dependencyGraph" }
      }
    },
    "dependencyGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_paths", "node_inventory", "edge_inventory", "graph_digest"],
      "properties": {
        "entry_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
        "node_inventory": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/dependencyNode" } },
        "edge_inventory": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/dependencyEdge" } },
        "graph_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "dependencyNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "file_type", "base_git_revision_bytes", "base_git_revision_sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/digest" },
        "file_type": { "enum": ["module", "json", "authority_data"] },
        "base_git_revision_bytes": { "type": "integer", "minimum": 1 },
        "base_git_revision_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "dependencyEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "kind", "specifier", "edge_digest"],
      "properties": {
        "from": { "$ref": "#/$defs/path" },
        "to": { "$ref": "#/$defs/path" },
        "kind": { "enum": ["static_import", "export_from", "dynamic_import", "runtime_private_import", "authority_read"] },
        "specifier": { "type": "string", "minLength": 1, "maxLength": 240 },
        "source_location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["line", "column"],
          "properties": {
            "line": { "type": "integer", "minimum": 1 },
            "column": { "type": "integer", "minimum": 1 }
          }
        },
        "syntax_identity": { "type": "string", "minLength": 1, "maxLength": 480 },
        "edge_digest": { "$ref": "#/$defs/digest" }
      },
      "anyOf": [
        { "required": ["source_location"] },
        { "required": ["syntax_identity"] }
      ]
    }
  }
}
