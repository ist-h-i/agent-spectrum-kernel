{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_kind",
    "policy_revision",
    "policy_digest",
    "scope",
    "registration_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "object_kind": {
      "const": "portfolio_high_impact_sensitivity_registration"
    },
    "policy_revision": {
      "const": "issue-197-high-impact-risk-boundary-v1"
    },
    "policy_digest": {
      "$ref": "portfolio-aggregate-result-v2.schema.json#/$defs/digest"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_revision",
        "plan_id",
        "plan_digest",
        "run_instance_id",
        "adapter_track",
        "group",
        "fixtures",
        "catalog_digest",
        "policy_manifest_digest",
        "scoring_policy_digest"
      ],
      "properties": {
        "source_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "plan_id": {
          "type": "string",
          "pattern": "^plan-[a-f0-9]{64}$"
        },
        "plan_digest": {
          "$ref": "portfolio-aggregate-result-v2.schema.json#/$defs/digest"
        },
        "run_instance_id": {
          "type": "string",
          "format": "uuid"
        },
        "adapter_track": {
          "enum": [
            "codex",
            "claude"
          ]
        },
        "group": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "comparison_view",
            "suite",
            "task_class"
          ],
          "properties": {
            "comparison_view": {
              "enum": [
                "kernel_vs_plain",
                "adaptive_vs_kernel",
                "full_vs_kernel_diagnostic"
              ]
            },
            "suite": {
              "enum": [
                "mechanism_positive",
                "mechanism_negative",
                "practice_frequency",
                "high_impact"
              ]
            },
            "task_class": {
              "$ref": "portfolio-aggregate-result-v2.schema.json#/$defs/token"
            }
          }
        },
        "fixtures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fixture_id",
              "fixture_input_digest",
              "expected_repetition_count"
            ],
            "properties": {
              "fixture_id": {
                "$ref": "portfolio-aggregate-result-v2.schema.json#/$defs/token"
              },
              "fixture_input_digest": {
                "$ref": "portfolio-aggregate-result-v2.schema.json#/$defs/digest"
              },
              "expected_repetition_count": {
                "enum": [
                  3,
                  5
                ]
              }
            }
          }
        },
        "catalog_digest": {
          "$ref": "portfolio-aggregate-result-v2.schema.json#/$defs/digest"
        },
        "policy_manifest_digest": {
          "$ref": "portfolio-aggregate-result-v2.schema.json#/$defs/digest"
        },
        "scoring_policy_digest": {
          "$ref": "portfolio-aggregate-result-v2.schema.json#/$defs/digest"
        }
      }
    },
    "registration_digest": {
      "$ref": "portfolio-aggregate-result-v2.schema.json#/$defs/digest"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independently pinned pre-result high-impact sensitivity registration"
}
