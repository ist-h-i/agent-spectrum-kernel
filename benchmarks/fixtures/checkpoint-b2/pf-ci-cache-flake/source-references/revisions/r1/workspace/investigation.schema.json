{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local build cache investigation",
  "type": "object",
  "required": [
    "summary",
    "confidence",
    "hypotheses",
    "experiments",
    "recommended_changes",
    "limitations"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "enum": [
        "confirmed_for_fixture",
        "supported",
        "unknown"
      ]
    },
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "cause",
          "status",
          "evidence"
        ],
        "properties": {
          "cause": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "supported",
              "contradicted",
              "unresolved"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "path",
                "line"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    },
    "experiments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "command",
          "observations",
          "conclusion"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "observations": {
            "type": "string",
            "minLength": 1
          },
          "conclusion": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "recommended_changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
