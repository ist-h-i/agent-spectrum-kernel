{
  "type": "object",
  "required": [
    "decision",
    "findings",
    "verification"
  ],
  "additionalProperties": false,
  "properties": {
    "decision": {
      "enum": [
        "request_changes",
        "approve",
        "comment"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "severity",
          "before_allowed",
          "after_allowed",
          "required_allowed",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "before_allowed": {
            "type": "boolean"
          },
          "after_allowed": {
            "type": "boolean"
          },
          "required_allowed": {
            "type": "boolean"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "path",
                "line"
              ],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "state",
        "commands"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "commands": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "npm test",
              "npm run trace",
              "npm run validate:review"
            ]
          }
        }
      }
    }
  }
}
