{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Data migration resume handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["current_state", "safe_next_action", "resume_gate", "rollback", "continuation"],
  "properties": {
    "current_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "last_completed_batch", "next_batch", "cursor", "write_traffic", "read_traffic", "blocking_condition_ids"],
      "properties": {
        "phase": { "type": "string", "minLength": 1 },
        "last_completed_batch": { "type": "integer", "minimum": 0 },
        "next_batch": { "type": "integer", "minimum": 1 },
        "cursor": { "type": "integer", "minimum": 0 },
        "write_traffic": { "$ref": "#/$defs/trafficSplit" },
        "read_traffic": { "$ref": "#/$defs/trafficSplit" },
        "blocking_condition_ids": { "$ref": "#/$defs/nonEmptyStringArray" }
      }
    },
    "safe_next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_id", "mode", "owner", "required_evidence_ids"],
      "properties": {
        "command_id": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["read_only", "write"] },
        "owner": { "type": "string", "minLength": 1 },
        "required_evidence_ids": { "$ref": "#/$defs/nonEmptyStringArray" }
      }
    },
    "resume_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval_role", "required_condition_ids"],
      "properties": {
        "approval_role": { "type": "string", "minLength": 1 },
        "required_condition_ids": { "$ref": "#/$defs/nonEmptyStringArray" }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported_action_ids", "forbidden_action_ids", "data_preservation"],
      "properties": {
        "supported_action_ids": { "$ref": "#/$defs/nonEmptyStringArray" },
        "forbidden_action_ids": { "$ref": "#/$defs/nonEmptyStringArray" },
        "data_preservation": { "type": "string", "minLength": 1 }
      }
    },
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stop_condition_ids", "verification_states", "evidence_references", "open_questions"],
      "properties": {
        "stop_condition_ids": { "$ref": "#/$defs/nonEmptyStringArray" },
        "verification_states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["verification_id", "state"],
            "properties": {
              "verification_id": { "type": "string", "minLength": 1 },
              "state": { "enum": ["passed", "failed", "not_run"] }
            }
          }
        },
        "evidence_references": { "$ref": "#/$defs/nonEmptyStringArray" },
        "open_questions": { "$ref": "#/$defs/nonEmptyStringArray" }
      }
    }
  },
  "$defs": {
    "trafficSplit": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 100 },
      "minProperties": 1,
      "propertyNames": { "minLength": 1 }
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
