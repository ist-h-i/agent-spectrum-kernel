{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Customer record v2",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "contactNote": {
      "type": "string",
      "default": ""
    }
