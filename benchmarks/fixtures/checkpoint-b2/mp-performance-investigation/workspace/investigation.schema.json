{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Summary latency investigation",
  "type": "object",
  "additionalProperties": false,
  "required": ["overall_assessment", "hypotheses", "next_check", "scope"],
  "properties": {
    "overall_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary"],
      "properties": {
        "status": { "enum": ["supported_not_proven", "insufficient_evidence", "no_regression"] },
        "summary": { "type": "string", "minLength": 1, "pattern": "\\S" }
      }
    },
    "hypotheses": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "state", "confidence", "rationale", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "state": { "enum": ["supported", "weakened", "falsified", "unresolved"] },
          "confidence": { "enum": ["high", "medium", "low"] },
          "rationale": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "line", "observation"],
              "properties": {
                "path": { "type": "string", "minLength": 1, "pattern": "\\S" },
                "line": { "type": "integer", "minimum": 1 },
                "observation": { "type": "string", "minLength": 1, "pattern": "\\S" }
              }
            }
          }
        }
      }
    },
    "next_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hypothesis_id", "environment", "action", "expected_observation", "stop_condition"],
      "properties": {
        "hypothesis_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "environment": { "enum": ["local_replay", "staging_read_only"] },
        "action": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "expected_observation": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "stop_condition": { "type": "string", "minLength": 1, "pattern": "\\S" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changes_made", "production_action_authorized"],
      "properties": {
        "changes_made": { "const": false },
        "production_action_authorized": { "const": false }
      }
    }
  }
}
