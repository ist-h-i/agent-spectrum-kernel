{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ist-h-i/agent-spectrum-kernel/schemas/instruction-asset-package.schema.json",
  "title": "Offline instruction Asset package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payload",
    "approval",
    "package_digest"
  ],
  "properties": {
    "payload": {
      "$ref": "#/$defs/payload"
    },
    "approval": {
      "$ref": "#/$defs/approval"
    },
    "package_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preview_digest",
        "evidence_digest",
        "intended_scope"
      ],
      "properties": {
        "preview_digest": {
          "$ref": "#/$defs/digest"
        },
        "evidence_digest": {
          "$ref": "#/$defs/digest"
        },
        "intended_scope": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "rationale",
        "applicability",
        "non_applicability",
        "exceptions",
        "verification",
        "refresh_condition",
        "validation_summary",
        "evidence_status"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/text"
        },
        "rationale": {
          "$ref": "#/$defs/text"
        },
        "applicability": {
          "$ref": "#/$defs/text"
        },
        "non_applicability": {
          "$ref": "#/$defs/text"
        },
        "exceptions": {
          "$ref": "#/$defs/text"
        },
        "verification": {
          "$ref": "#/$defs/text"
        },
        "refresh_condition": {
          "$ref": "#/$defs/text"
        },
        "validation_summary": {
          "$ref": "#/$defs/text"
        },
        "evidence_status": {
          "enum": [
            "Verified",
            "Supported",
            "Hypothesis",
            "Unknown",
            "Falsified"
          ]
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "text",
        "raw_digest"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 131072
        },
        "raw_digest": {
          "$ref": "#/$defs/digest"
        },
        "media_type": {
          "type": "string",
          "enum": [
            "text/markdown; charset=utf-8",
            "text/javascript",
            "text/x-python",
            "text/x-shellscript",
            "text/typescript",
            "application/json",
            "text/yaml",
            "text/plain"
          ]
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ref_digest",
        "stable_id",
        "version",
        "asset_type",
        "adapter",
        "entrypoint",
        "dependencies",
        "required_capabilities",
        "metadata",
        "files",
        "adapter_constraints",
        "runtime_profiles",
        "restrictions"
      ],
      "properties": {
        "source_ref_digest": {
          "$ref": "#/$defs/digest"
        },
        "stable_id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/id"
        },
        "asset_type": {
          "enum": [
            "skill",
            "prompt"
          ]
        },
        "adapter": {
          "enum": [
            "shared",
            "codex",
            "claude_code"
          ]
        },
        "entrypoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "dependencies": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/digest"
          }
        },
        "required_capabilities": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "files": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/file"
          },
          "minItems": 1
        },
        "adapter_constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "included",
            "excluded"
          ],
          "properties": {
            "status": {
              "enum": [
                "unknown",
                "unrestricted",
                "bounded"
              ]
            },
            "included": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "excluded": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/id"
              }
            }
          }
        },
        "runtime_profiles": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "restrictions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requested_permissions",
            "possible_effects",
            "classifications"
          ],
          "properties": {
            "requested_permissions": {
              "type": "array",
              "maxItems": 256,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "possible_effects": {
              "type": "array",
              "maxItems": 256,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "classifications": {
              "type": "array",
              "maxItems": 256,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "contract_version",
        "source_scope_digest",
        "intended_scope",
        "assets"
      ],
      "properties": {
        "kind": {
          "const": "offline_instruction_asset_package"
        },
        "contract_version": {
          "enum": [
            "1.0.0",
            "1.1.0"
          ]
        },
        "source_scope_digest": {
          "$ref": "#/$defs/digest"
        },
        "intended_scope": {
          "$ref": "#/$defs/id"
        },
        "assets": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/asset"
          },
          "minItems": 1
        }
      }
    }
  }
}
