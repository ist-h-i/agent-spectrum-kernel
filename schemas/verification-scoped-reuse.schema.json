{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ist-h-i/agent-spectrum-kernel/schemas/verification-scoped-reuse.schema.json",
  "title": "Agent Spectrum Kernel scoped verification reuse, delta review, and current coverage",
  "oneOf": [
    { "$ref": "#/$defs/dependencyManifest" },
    { "$ref": "#/$defs/scopedRequirements" },
    { "$ref": "#/$defs/scopedPlan" },
    { "$ref": "#/$defs/deltaReviewRequest" },
    { "$ref": "#/$defs/currentCoverage" }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:#@+/-]*$"
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?:\\.|(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))[A-Za-z0-9._?*-]+(?:/[A-Za-z0-9._?*-]+)*)$"
    },
    "artifactHeader": {
      "type": "object",
      "properties": {
        "schema_version": { "type": "string", "const": "1.0.0" },
        "schema_path": { "type": "string", "const": "schemas/verification-scoped-reuse.schema.json" }
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "pattern", "evidence_kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["file", "directory", "glob"] },
        "pattern": { "$ref": "#/$defs/portablePath" },
        "evidence_kind": { "type": "string", "enum": ["contract", "dependency", "file", "fixture", "manifest", "schema"] }
      }
    },
    "reviewSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "pattern"],
      "properties": {
        "kind": { "type": "string", "enum": ["file", "directory", "glob"] },
        "pattern": { "$ref": "#/$defs/portablePath" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "argument_identity_scheme", "arguments_digest", "argument_count", "opaque_argument_count", "working_directory"],
      "properties": {
        "executable": { "$ref": "#/$defs/token" },
        "argument_identity_scheme": { "type": "string", "const": "opaque-references-v1" },
        "arguments_digest": { "$ref": "#/$defs/digest" },
        "argument_count": { "type": "integer", "minimum": 0, "maximum": 128 },
        "opaque_argument_count": { "type": "integer", "minimum": 0, "maximum": 128 },
        "working_directory": { "$ref": "#/$defs/portablePath" }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner_id", "runner_version", "adapter_id", "adapter_version", "evidence_level"],
      "properties": {
        "runner_id": { "$ref": "#/$defs/token" },
        "runner_version": { "$ref": "#/$defs/token" },
        "adapter_id": { "$ref": "#/$defs/token" },
        "adapter_version": { "$ref": "#/$defs/token" },
        "evidence_level": { "type": "string", "enum": ["projected", "runtime_detected", "executed", "behavior_verified"] }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["independent_judgment_required", "accepted_producers", "accepted_evidence_levels"],
      "properties": {
        "independent_judgment_required": { "type": "boolean" },
        "accepted_producers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "identity_digest"],
            "properties": {
              "kind": { "type": "string", "enum": ["automation", "ci", "developer", "reviewer"] },
              "identity_digest": { "$ref": "#/$defs/digest" }
            }
          }
        },
        "accepted_evidence_levels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["projected", "runtime_detected", "executed", "behavior_verified"] }
        }
      }
    },
    "dependencyManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "schema_path", "program", "manifest_id", "manifest_digest",
        "gate_id", "gate_contract_digest", "dependency_completeness", "base_inventory_digest",
        "selectors", "execution", "runtime_observation", "invalidation"
      ],
      "properties": {
        "schema_version": { "type": "string", "const": "1.0.0" },
        "schema_path": { "type": "string", "const": "schemas/verification-scoped-reuse.schema.json" },
        "program": { "type": "string", "const": "ask_verification_dependency_manifest" },
        "manifest_id": { "type": "string", "pattern": "^verification-dependency-manifest-[a-f0-9]{64}$" },
        "manifest_digest": { "$ref": "#/$defs/digest" },
        "gate_id": { "$ref": "#/$defs/token" },
        "gate_contract_digest": { "$ref": "#/$defs/digest" },
        "dependency_completeness": { "type": "string", "enum": ["complete", "incomplete"] },
        "base_inventory_digest": { "$ref": "#/$defs/digest" },
        "selectors": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/selector" } },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command", "runner"],
          "properties": {
            "command": { "$ref": "#/$defs/command" },
            "runner": { "$ref": "#/$defs/runner" }
          }
        },
        "runtime_observation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "toolchain_names"],
          "properties": {
            "mode": { "type": "string", "enum": ["node_process_v1", "unknown"] },
            "toolchain_names": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/token" }
            }
          }
        },
        "invalidation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unknown_dependencies_require_rerun"],
          "properties": {
            "unknown_dependencies_require_rerun": { "type": "boolean", "const": true }
          }
        }
      }
    },
    "deltaReviewRequirement": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["surface_selectors", "obligation_refs", "prior_review_ref", "prior_finding_refs"],
      "properties": {
        "surface_selectors": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/reviewSelector" } },
        "obligation_refs": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/token" } },
        "prior_review_ref": { "oneOf": [{ "$ref": "#/$defs/token" }, { "type": "null" }] },
        "prior_finding_refs": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/token" } }
      }
    },
    "requiredGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "dependency_manifest_path", "source_evidence_id", "required_obligation_refs", "authority", "execution_availability", "delta_review"],
      "properties": {
        "gate_id": { "$ref": "#/$defs/token" },
        "dependency_manifest_path": { "$ref": "#/$defs/portablePath" },
        "source_evidence_id": { "type": "string", "pattern": "^verification-evidence-[a-f0-9]{64}$" },
        "required_obligation_refs": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/token" } },
        "authority": { "$ref": "#/$defs/authority" },
        "execution_availability": { "type": "string", "enum": ["available", "unavailable"] },
        "delta_review": { "$ref": "#/$defs/deltaReviewRequirement" }
      }
    },
    "currentObligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligation_id", "kind"],
      "properties": {
        "obligation_id": { "$ref": "#/$defs/token" },
        "kind": { "type": "string", "enum": ["pr_head", "required_ci", "approval", "mergeability", "release_state", "authorization", "external_state"] }
      }
    },
    "scopedRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "schema_path", "program", "requirements_id", "requirements_digest", "base_revision", "required_gates", "current_obligations"],
      "properties": {
        "schema_version": { "type": "string", "const": "1.0.0" },
        "schema_path": { "type": "string", "const": "schemas/verification-scoped-reuse.schema.json" },
        "program": { "type": "string", "const": "ask_verification_scoped_requirements" },
        "requirements_id": { "type": "string", "pattern": "^verification-scoped-requirements-[a-f0-9]{64}$" },
        "requirements_digest": { "$ref": "#/$defs/digest" },
        "base_revision": { "$ref": "#/$defs/commit" },
        "required_gates": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/requiredGate" } },
        "current_obligations": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/currentObligation" } }
      }
    },
    "inventoryEntry": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["path", "evidence_kind", "mode", "type", "object_id", "content_digest"],
      "properties": {
        "path": { "$ref": "#/$defs/portablePath" },
        "evidence_kind": { "type": "string", "enum": ["contract", "dependency", "file", "fixture", "manifest", "schema"] },
        "mode": { "type": "string", "pattern": "^[0-9]{6}$" },
        "type": { "type": "string", "enum": ["blob", "commit", "tree"] },
        "object_id": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "content_digest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }
      }
    },
    "inventoryChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "before", "after"],
      "properties": {
        "path": { "$ref": "#/$defs/portablePath" },
        "kind": { "type": "string", "enum": ["added", "deleted", "content_changed", "mode_changed", "type_changed"] },
        "before": { "$ref": "#/$defs/inventoryEntry" },
        "after": { "$ref": "#/$defs/inventoryEntry" }
      }
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id", "disposition", "reason_code", "source_evidence_id", "source_evidence_digest",
        "dependency_manifest_id", "dependency_manifest_digest", "base_inventory_digest", "target_inventory_digest",
        "required_obligation_refs", "covered_obligation_refs", "uncovered_obligation_refs", "execution_evidence_reusable",
        "reuse_basis", "detail"
      ],
      "properties": {
        "gate_id": { "$ref": "#/$defs/token" },
        "disposition": { "type": "string", "enum": ["reuse_exact", "reuse_scoped", "rerun_required", "independent_judgment_required", "blocked_uncovered"] },
        "reason_code": { "$ref": "#/$defs/token" },
        "source_evidence_id": { "type": "string", "pattern": "^verification-evidence-[a-f0-9]{64}$" },
        "source_evidence_digest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "dependency_manifest_id": { "oneOf": [{ "type": "string", "pattern": "^verification-dependency-manifest-[a-f0-9]{64}$" }, { "type": "null" }] },
        "dependency_manifest_digest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "base_inventory_digest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
