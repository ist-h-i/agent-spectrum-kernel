{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ist-h-i/agent-spectrum-kernel/schemas/codex-risk-approval-request.schema.json",
  "title": "Codex Exact Risk Approval Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "approval_authority", "action", "action_sha256", "action_file_sha256", "invocation", "invocation_sha256", "request_sha256"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "kind": { "type": "string", "const": "codex_risk_approval_request" },
    "approval_authority": { "$ref": "codex-risk-action.schema.json#/properties/approval_authority" },
    "action": { "$ref": "codex-risk-action.schema.json" },
    "action_sha256": { "$ref": "#/$defs/digest" },
    "action_file_sha256": { "$ref": "#/$defs/digest" },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "target_scope", "prompt", "profile", "executor", "environment", "runtime_policy", "mode", "sandbox", "required_gates", "risk_gate", "operation", "permitted_effects", "prohibited_effects"],
      "properties": {
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository_id", "repository_identity_sha256", "head_sha", "tree_sha"],
          "properties": {
            "repository_id": { "$ref": "codex-risk-action.schema.json#/$defs/repository_id" },
            "repository_identity_sha256": { "$ref": "#/$defs/digest" },
            "head_sha": { "$ref": "#/$defs/git_sha" },
            "tree_sha": { "$ref": "#/$defs/git_sha" }
          }
        },
        "target_scope": { "$ref": "codex-risk-action.schema.json#/properties/target_scope" },
        "prompt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entry_id", "rendered_sha256", "invocation_sha256"],
          "properties": {
            "entry_id": { "type": "string", "enum": ["skill-implement.md", "skill-investigate.md", "skill-review.md", "skill-verify.md", "skill-handoff.md"] },
            "rendered_sha256": { "$ref": "#/$defs/digest" },
            "invocation_sha256": { "$ref": "#/$defs/digest" }
          }
        },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["installed_profile", "profile_id", "profile_schema_version", "canonical_revision", "canonical_source_digest", "profile_fingerprint"],
          "properties": {
            "installed_profile": { "type": "string", "minLength": 1, "maxLength": 200 },
            "profile_id": { "type": "string", "minLength": 1, "maxLength": 200 },
            "profile_schema_version": { "type": "string", "minLength": 1, "maxLength": 50 },
            "canonical_revision": { "type": "string", "minLength": 1, "maxLength": 200 },
            "canonical_source_digest": { "$ref": "#/$defs/digest" },
            "profile_fingerprint": { "$ref": "#/$defs/digest" }
          }
        },
        "executor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requested_bin", "resolution", "target_triple", "launcher", "package_manifest", "platform_manifest", "native_binary", "spawn_path", "output_path", "candidate_network_access"],
          "properties": {
            "requested_bin": { "type": "string", "minLength": 1, "maxLength": 1000 },
            "resolution": { "type": "string", "const": "installed_openai_codex_platform_package" },
            "target_triple": { "type": "string", "minLength": 1, "maxLength": 100 },
            "launcher": { "$ref": "#/$defs/executable_file" },
            "package_manifest": { "$ref": "#/$defs/package_manifest" },
            "platform_manifest": { "$ref": "#/$defs/package_manifest" },
            "native_binary": {
              "type": "object",
              "additionalProperties": false,
              "required": ["canonical_path", "raw_sha256", "size_bytes", "executable_format"],
              "properties": {
                "canonical_path": { "type": "string", "minLength": 1, "maxLength": 4096 },
                "raw_sha256": { "$ref": "#/$defs/digest" },
                "size_bytes": { "type": "integer", "minimum": 1, "maximum": 536870912 },
                "executable_format": { "type": "string", "enum": ["mach-o", "elf", "pe"] }
              }
            },
            "spawn_path": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "output_path": { "type": "string", "minLength": 1, "maxLength": 1000 },
            "candidate_network_access": { "type": "string", "const": "disabled" }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inheritance", "public_bindings", "secret_bindings", "stripped_injection_families", "environment_sha256"],
          "properties": {
            "inheritance": { "type": "string", "const": "none" },
            "public_bindings": {
              "type": "array",
              "minItems": 8,
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "value"],
                "properties": {
                  "name": { "type": "string", "enum": ["PATH", "HOME", "CODEX_HOME", "LANG", "LC_ALL", "NO_COLOR", "TERM", "SHELL"] },
                  "value": { "type": "string", "minLength": 1, "maxLength": 4096 }
                }
              }
            },
            "secret_bindings": {
              "type": "array",
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "value_sha256"],
                "properties": {
                  "name": { "type": "string", "enum": ["CODEX_API_KEY", "OPENAI_API_KEY"] },
                  "value_sha256": { "$ref": "#/$defs/digest" }
                }
              }
            },
            "stripped_injection_families": { "const": ["NODE_*", "npm_*", "DYLD_*", "LD_*", "*_PROXY", "BASH_ENV", "ENV", "GIT_*", "SSH_*"] },
            "environment_sha256": { "$ref": "#/$defs/digest" }
          }
        },
        "runtime_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["user_config", "execpolicy_rules", "session_persistence", "mcp_servers", "plugins", "external_tool_discovery", "shell_environment_inheritance", "web_search", "candidate_network_access", "telemetry", "update_checks", "model_control_plane", "builtin_mutation_tools", "executor_resolution", "environment_inheritance", "project_config_layers", "system_config_layers", "system_config_paths", "disabled_features", "argv", "argv_sha256"],
          "properties": {
            "user_config": { "type": "string", "const": "ignored" },
            "execpolicy_rules": { "type": "string", "const": "ignored" },
            "session_persistence": { "type": "string", "const": "ephemeral" },
            "mcp_servers": { "type": "string", "const": "disabled" },
            "plugins": { "type": "string", "const": "disabled" },
            "external_tool_discovery": { "type": "string", "const": "disabled" },
            "shell_environment_inheritance": { "type": "string", "const": "none" },
            "web_search": { "type": "string", "const": "disabled" },
            "candidate_network_access": { "type": "string", "const": "disabled" },
            "telemetry": { "type": "string", "const": "disabled" },
            "update_checks": { "type": "string", "const": "disabled" },
            "model_control_plane": { "type": "string", "const": "codex_api_only" },
            "builtin_mutation_tools": { "const": ["shell_tool", "unified_exec"] },
            "executor_resolution": { "type": "string", "const": "stable_native_direct_spawn" },
            "environment_inheritance": { "type": "string", "const": "closed_allowlist" },
            "project_config_layers": { "type": "string", "const": "reject_and_read_deny" },
            "system_config_layers": { "type": "string", "const": "read_deny" },
            "system_config_paths": { "const": ["/etc/codex/config.toml", "/etc/codex/managed_config.toml", "/etc/codex/requirements.toml", "/Library/Managed Preferences/com.openai.codex.plist", "/Library/Preferences/com.openai.codex.plist"] },
            "disabled_features": {
              "const": ["apps", "auth_elicitation", "browser_use", "browser_use_external", "browser_use_full_cdp_access", "code_mode_host", "computer_use", "enable_mcp_apps", "executor_capability_discovery", "guardian_approval", "hooks", "image_generation", "in_app_browser", "in_app_updates", "mcp_2026_07_28", "memories", "multi_agent", "multi_agent_v2", "plugin_sharing", "plugins", "recommended_plugins", "remote_plugin", "skill_mcp_dependency_install", "skill_search", "shell_snapshot", "standalone_web_search", "tool_call_mcp_elicitation", "tool_suggest", "view_image", "workspace_dependencies"]
            },
            "argv": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": { "type": "string", "minLength": 1, "maxLength": 500 }
            },
            "argv_sha256": { "$ref": "#/$defs/digest" }
          }
        },
        "mode": { "type": "string", "enum": ["implementation", "investigation", "review", "verification", "handoff"] },
        "sandbox": { "type": "string", "enum": ["read-only", "workspace-write"] },
        "required_gates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "codex-risk-action.schema.json#/$defs/identifier" }
        },
        "risk_gate": { "type": "string", "const": "risk-gate" },
        "operation": { "$ref": "codex-risk-action.schema.json#/$defs/identifier" },
        "permitted_effects": { "$ref": "codex-risk-action.schema.json#/properties/permitted_effects" },
        "prohibited_effects": { "$ref": "codex-risk-action.schema.json#/properties/prohibited_effects" }
      }
    },
    "invocation_sha256": { "$ref": "#/$defs/digest" },
    "request_sha256": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "git_sha": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "executable_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_path", "raw_sha256", "size_bytes"],
      "properties": {
        "canonical_path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "raw_sha256": { "$ref": "#/$defs/digest" },
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 536870912 }
      }
    },
    "package_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_path", "raw_sha256", "size_bytes", "package_name", "package_version"],
      "properties": {
        "canonical_path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "raw_sha256": { "$ref": "#/$defs/digest" },
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "package_name": { "type": "string", "const": "@openai/codex" },
        "package_version": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    }
  }
}
