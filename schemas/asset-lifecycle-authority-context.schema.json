{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ist-h-i/agent-spectrum-kernel/schemas/asset-lifecycle-authority-context.schema.json",
  "title": "Agent Spectrum Kernel Asset lifecycle authority context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "object_kind", "registry_id", "repository_id", "scope_id",
    "predecessor_snapshot_digest", "transitions", "transition_basis_digest", "authority", "context_digest"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "object_kind": { "type": "string", "const": "asset_lifecycle_authority_context" },
    "registry_id": { "$ref": "#/$defs/stableId" },
    "repository_id": { "$ref": "#/$defs/repositoryId" },
    "scope_id": { "$ref": "#/$defs/stableId" },
    "predecessor_snapshot_digest": { "$ref": "#/$defs/digest" },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/transition" }
    },
    "transition_basis_digest": { "$ref": "#/$defs/digest" },
    "authority": { "$ref": "#/$defs/authority" },
    "context_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "stableId": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "repositoryId": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$" },
    "assetType": { "type": "string", "enum": ["skill", "prompt", "evaluator_reference"] },
    "state": { "type": "string", "enum": ["candidate", "admitted", "current", "historical", "superseded", "retired"] },
    "exactAssetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_type", "stable_id", "version", "record_digest", "content_digest"],
      "properties": {
        "asset_type": { "$ref": "#/$defs/assetType" },
        "stable_id": { "$ref": "#/$defs/stableId" },
        "version": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]*$" },
        "record_digest": { "$ref": "#/$defs/digest" },
        "content_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset", "from_state", "to_state"],
      "properties": {
        "asset": { "$ref": "#/$defs/exactAssetRef" },
        "from_state": { "$ref": "#/$defs/state" },
        "to_state": { "$ref": "#/$defs/state" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "authority_id", "authority_revision", "authority_evidence_digest"],
      "properties": {
        "kind": { "type": "string", "enum": ["external_asset_lifecycle_authority", "external_asset_rollback_authority"] },
        "authority_id": { "$ref": "#/$defs/stableId" },
        "authority_revision": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S" },
        "authority_evidence_digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
