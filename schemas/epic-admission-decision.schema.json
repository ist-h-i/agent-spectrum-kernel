{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-spectrum-kernel.local/schemas/epic-admission-decision.schema.json",
  "title": "ASK Epic Admission Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "program",
    "decision_id",
    "decision_revision",
    "subject",
    "policy_ref",
    "observed_signals",
    "computed_decision",
    "effective_decision",
    "reason_codes",
    "unresolved_scope",
    "blockers",
    "override",
    "digest_contract",
    "decision_digest"
  ],
  "properties": {
    "schema_version": { "const": "1.1.0" },
    "artifact_type": { "const": "epic_admission_decision" },
    "program": { "const": "ask_epic_admission" },
    "decision_id": { "$ref": "#/$defs/stableId" },
    "decision_revision": { "type": "integer", "minimum": 1 },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "goal_id", "task_id", "base_commit", "base_tree", "branch"],
      "properties": {
        "repository_id": { "$ref": "#/$defs/repositoryId" },
        "goal_id": { "$ref": "#/$defs/stableId" },
        "task_id": { "$ref": "#/$defs/stableId" },
        "base_commit": { "$ref": "#/$defs/gitObjectId" },
        "base_tree": { "$ref": "#/$defs/gitObjectId" },
        "branch": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "policy_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_revision", "policy_digest"],
      "properties": {
        "policy_id": { "$ref": "#/$defs/stableId" },
        "policy_revision": { "type": "integer", "minimum": 1 },
        "policy_digest": { "$ref": "#/$defs/sha256Digest" }
      }
    },
    "observed_signals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configured_epic",
        "acceptance_condition_count",
        "acceptance_registry_digest",
        "scope_boundary_count",
        "ordered_dependency",
        "independent_publication_units",
        "scope_resolution",
        "ai_estimated_complexity"
      ],
      "properties": {
        "configured_epic": { "$ref": "#/$defs/booleanSignal" },
        "acceptance_condition_count": { "$ref": "#/$defs/countSignal" },
        "acceptance_registry_digest": { "$ref": "#/$defs/digestSignal" },
        "scope_boundary_count": { "$ref": "#/$defs/countSignal" },
        "ordered_dependency": { "$ref": "#/$defs/booleanSignal" },
        "independent_publication_units": { "$ref": "#/$defs/booleanSignal" },
        "scope_resolution": { "$ref": "#/$defs/scopeSignal" },
        "ai_estimated_complexity": { "$ref": "#/$defs/complexitySignal" }
      }
    },
    "computed_decision": { "$ref": "#/$defs/admissionDecision" },
    "effective_decision": { "$ref": "#/$defs/admissionDecision" },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/stableId" }
    },
    "unresolved_scope": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/stableId" }
    },
    "override": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "rule_id", "requested_decision", "reason", "authority_grant_id", "authority_ref", "authority_kind"],
      "properties": {
        "state": { "enum": ["not_requested", "applied", "rejected"] },
        "rule_id": { "type": ["string", "null"], "maxLength": 160 },
        "requested_decision": {
          "type": ["string", "null"],
          "enum": ["ordinary_execution_allowed", "work_package_plan_required", "human_decision_required", null]
        },
        "reason": { "type": ["string", "null"], "maxLength": 1000 },
        "authority_grant_id": { "type": ["string", "null"], "maxLength": 160 },
        "authority_ref": { "type": ["string", "null"], "maxLength": 512 },
        "authority_kind": { "type": ["string", "null"], "maxLength": 160 }
      }
    },
    "digest_contract": { "$ref": "#/$defs/digestContract" },
    "decision_digest": { "$ref": "#/$defs/sha256Digest" }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1, "maxLength": 512 },
    "stableId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]*$" },
    "repositoryId": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "gitObjectId": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256Digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "evidenceStatus": { "enum": ["verified", "supported", "hypothesis", "unknown", "falsified"] },
    "signalBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "evidence_status", "evidence_ref"]
    },
    "booleanSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "evidence_status", "evidence_ref"],
      "properties": {
        "value": { "type": "boolean" },
        "evidence_status": { "$ref": "#/$defs/evidenceStatus" },
        "evidence_ref": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "countSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "evidence_status", "evidence_ref"],
      "properties": {
        "value": { "type": "integer", "minimum": 0 },
        "evidence_status": { "$ref": "#/$defs/evidenceStatus" },
        "evidence_ref": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "digestSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "evidence_status", "evidence_ref"],
      "properties": {
        "value": { "$ref": "#/$defs/sha256Digest" },
        "evidence_status": { "$ref": "#/$defs/evidenceStatus" },
        "evidence_ref": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "scopeSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "evidence_status", "evidence_ref"],
      "properties": {
        "value": { "enum": ["resolved", "unresolved", "contradictory", "unknown"] },
        "evidence_status": { "$ref": "#/$defs/evidenceStatus" },
        "evidence_ref": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "complexitySignal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "evidence_status", "evidence_ref"],
      "properties": {
        "value": { "enum": ["small", "medium", "large", "unknown"] },
        "evidence_status": { "$ref": "#/$defs/evidenceStatus" },
        "evidence_ref": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "admissionDecision": {
      "enum": [
        "ordinary_execution_allowed",
        "work_package_plan_required",
        "human_decision_required"
      ]
    },
    "digestContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "excluded_field"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "canonicalization": { "const": "sorted_key_canonical_json" },
        "excluded_field": { "const": "decision_digest" }
      }
    }
  }
}
