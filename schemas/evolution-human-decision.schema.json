{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ist-h-i/agent-spectrum-kernel/schemas/evolution-human-decision.schema.json",
  "title": "Agent Spectrum Kernel exact human Evolution decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_kind",
    "proposal_digest",
    "action",
    "disposition",
    "reason_codes",
    "authority",
    "authority_implied",
    "decision_digest"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "object_kind": { "type": "string", "const": "evolution_human_decision" },
    "proposal_digest": { "$ref": "#/$defs/digest" },
    "action": { "$ref": "#/$defs/action" },
    "disposition": {
      "type": "string",
      "enum": ["approved", "declined", "request_revision"]
    },
    "reason_codes": { "$ref": "#/$defs/nonEmptyTokenSet" },
    "authority": { "$ref": "#/$defs/decisionAuthority" },
    "authority_implied": { "type": "boolean", "const": false },
    "decision_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:#@/+~-]*$"
    },
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "nonEmptyTokenSet": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/token" }
    },
    "action": {
      "type": "string",
      "enum": [
        "adopt_candidate",
        "retain_current",
        "revise_candidate",
        "reject_candidate",
        "retire_current",
        "insufficient_evidence"
      ]
    },
    "decisionAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "authority_id", "authority_revision", "authority_evidence_digest"],
      "properties": {
        "kind": { "type": "string", "const": "external_evolution_human_decision_authority" },
        "authority_id": { "$ref": "#/$defs/stableId" },
        "authority_revision": { "type": "integer", "minimum": 1 },
        "authority_evidence_digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
